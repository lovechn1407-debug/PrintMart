{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "./dist-electron",
    "rootDir": "./electron",
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@printmart/shared": ["../../packages/shared/dist/index"]
    }
  },
  "include": ["electron/**/*"]
}
