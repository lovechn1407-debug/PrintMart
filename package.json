{
  "name": "printmart-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@printmart/web",
    "dev:kiosk": "npm run dev --workspace=@printmart/kiosk",
    "build:web": "npm run build --workspace=@printmart/web",
    "build:kiosk": "npm run build --workspace=@printmart/kiosk"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
